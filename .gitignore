# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Packaging and build outputs
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Virtual environments and local config
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Editor, OS, and temporary files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Logs and runtime scratch files
*.log
*.tmp
*.temp

# Benchmark outputs generated by local runs
benchmarks/*.json
benchmarks/*.jsonl
!benchmarks/.gitkeep

# Chess engine build artifacts
engines/*.tar
engines/*.tar.*
engines/stockfish/stockfish-*
engines/stockfish/stockfish-macos-*
engines/stockfish/src/*.o
engines/stockfish/src/*.obj
engines/stockfish/src/*.d
engines/stockfish/src/stockfish
engines/stockfish/src/stockfish-*
engines/stockfish/src/profile-build/
engines/stockfish/src/*.nnue
